[Unit]
Description=Parrhesia encrypted chat backend
After=network.target

[Service]
Type=simple
User=parrhesia
Group=parrhesia
WorkingDirectory=/var/lib/parrhesia
ExecStart=/opt/parrhesia/current/parrhesia
EnvironmentFile=/etc/parrhesia/parrhesia.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=parrhesia
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/parrhesia

[Install]
WantedBy=multi-user.target
