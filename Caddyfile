api.parrhesia.chat {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	reverse_proxy 127.0.0.1:3000 {
		# Overwrite even a client-supplied header. For non-Cloudflare connections,
		# Caddy uses the TCP peer address instead of accepting forwarded values.
		header_up X-Parrhesia-Client-IP {client_ip}
	}
}
